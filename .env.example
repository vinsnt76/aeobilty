# Environment Variables Template
# Copy this file to .env.local and fill in the values.

# Google Wallet Integration
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PROJECT_ID=
GOOGLE_WALLET_PRIVATE_KEY=""

# Resend API Key (Stored securely in Vercel secrets for production)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="AEObility Diagnostics <reports@aeobility.com.au>"
TEAM_NOTIFICATION_EMAIL="support@aeobility.com.au, vince@aeobility.com.au"

# AI & Search API Keys
GEMINI_API_KEY=
BRAVE_API_KEY=
OPENAI_API_KEY=
VERCEL_AI_OPENAI_API_KEY=

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=

# Google Search Console Telemetry & URL Inspection
GSC_KEY_FILE_PATH=./antigravity-cli-and-adk-500010-6c74add7d8e4.json
GSC_SITE_URL=sc-domain:aeobility.com.au
